# Copy this file to .env and fill in real values.
# Never commit the .env file itself.
#
# This dependency-free example needs no API keys. The one setting it reads is
# the CSA role for a --serve session — in production the gateway injects the
# authenticated operator's identity; here you set it explicitly.
#
# One of: csa.read (first-line) | csa.write (senior) | csa.refund (lead)
ORDERCORE_CSA_ROLE=csa.read

# A real OrderCore adapter would also need connection details, e.g.:
# ORDERCORE_DB_ENDPOINT=<your-endpoint>
# ORDERCORE_DB_USER=<your-user>
